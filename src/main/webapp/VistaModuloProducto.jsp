<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@include file="components/auth.jsp"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@include file="components/head.jsp"%>
<%@include file="components/sidebar.jsp"%>
<%@include file="components/navBar.jsp"%>
<header class="page-header"><div><span class="page-kicker">Catálogos · Inventario</span><h1>Productos</h1><p>Precios, categorías y existencias disponibles.</p></div><div class="page-actions"><a class="btn btn-primary" href="${pageContext.request.contextPath}/SvAddProducto"><i class="fas fa-plus"></i> Nuevo producto</a></div></header>
<c:if test="${not empty param.error}"><div class="notice notice-error" role="alert"><i class="fas fa-exclamation-circle"></i><span>No se puede eliminar un producto usado en compras o ventas.</span></div></c:if>
<c:if test="${not empty param.ok}"><div class="notice notice-success" role="status"><i class="fas fa-check-circle"></i><span>Producto <c:out value="${param.ok}"/> correctamente.</span></div></c:if>
<section class="surface"><div class="section-title"><h2>Inventario</h2><small>Turno <c:out value="${turno}"/> · <c:out value="${fecha}"/></small></div><c:choose><c:when test="${empty productos}"><div class="empty-state"><i class="fas fa-box-open"></i><h3>Sin productos</h3><p>Registra un producto para empezar a vender o comprar.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/SvAddProducto">Crear producto</a></div></c:when><c:otherwise><div class="table-responsive"><table><thead><tr><th>ID</th><th>Producto</th><th class="numeric">Compra</th><th class="numeric">Venta</th><th class="numeric">Stock</th><th>Categoría</th><th>Acciones</th></tr></thead><tbody><c:forEach var="producto" items="${productos}"><tr><td class="data-code">#${producto.id}</td><td><c:out value="${producto.nombre}"/></td><td class="numeric">S/ ${producto.precioCompra}</td><td class="numeric">S/ ${producto.precioVenta}</td><td class="numeric">${producto.stock}</td><td><c:out value="${producto.categoria}"/></td><td class="actions-cell"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/SvUpdateProducto?accion=actualizar&amp;idProducto=${producto.id}">Editar</a><form action="${pageContext.request.contextPath}/SvDeleteProducto?accion=eliminar" method="post" data-confirm="¿Eliminar este producto?"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="idProducto" value="${producto.id}"><button class="btn btn-danger btn-sm" type="submit">Eliminar</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section>
<%@include file="components/footer.jsp"%>
