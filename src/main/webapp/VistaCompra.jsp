<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@include file="components/auth.jsp"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@include file="components/head.jsp"%>
<%@include file="components/sidebar.jsp"%>
<%@include file="components/navBar.jsp"%>
<header class="page-header"><div><span class="page-kicker">Comercial · Abastecimiento</span><h1>Compras</h1><p>Agrega productos y registra el ingreso de mercadería.</p></div><div class="page-actions"><span class="page-meta">Turno <strong><c:out value="${rcompra.turno}"/></strong> · <c:out value="${rcompra.fecha}"/></span></div></header>
<c:if test="${not empty sessionScope.errorCompra}"><div class="notice notice-error" role="alert"><i class="fas fa-exclamation-circle"></i><span><c:out value="${sessionScope.errorCompra}"/></span></div><c:remove var="errorCompra" scope="session"/></c:if>
<c:if test="${not empty param.ok}"><div class="notice notice-success" role="status"><i class="fas fa-check-circle"></i><span>Compra guardada correctamente.</span></div></c:if>
<c:if test="${empty proveedores or empty productos}"><div class="notice notice-warning"><i class="fas fa-info-circle"></i><span>Registra un proveedor y un producto antes de comenzar. <a href="${pageContext.request.contextPath}/SvProveedor">Gestionar proveedores</a></span></div></c:if>
<div class="ledger-layout">
<section class="ledger-surface"><div class="kicker-line"></div><div class="section-title"><h2>Agregar producto</h2></div><form action="${pageContext.request.contextPath}/SvCompra?accion=agregar" method="post"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
<div class="field"><label for="proveedor_name">Proveedor</label><select id="proveedor_name" name="proveedorId" required><option value="">Seleccionar proveedor</option><c:forEach var="proveedor" items="${proveedores}"><option value="${proveedor.id}"><c:out value="${proveedor.razonSocial}"/></option></c:forEach></select></div>
<div class="field"><label for="producto_name">Producto</label><select id="producto_name" name="productoId" required><option value="">Seleccionar producto</option><c:forEach var="producto" items="${productos}"><option value="${producto.id}"><c:out value="${producto.nombre}"/></option></c:forEach></select></div>
<div class="field"><label for="cantidad">Cantidad</label><input type="number" id="cantidad" name="cantidad" min="1" placeholder="Ejemplo: 5" required></div><div class="form-actions"><button class="btn btn-primary" type="submit"><i class="fas fa-plus"></i> Agregar a la compra</button></div></form></section>
<section class="ledger-surface"><div class="section-title"><h2>Detalle de la compra</h2><small>Revisa antes de guardar</small></div>
<c:choose><c:when test="${empty compra.lineaCompras}"><div class="empty-state"><i class="fas fa-box-open"></i><h3>La compra está vacía</h3><p>Selecciona un proveedor, producto y cantidad para comenzar.</p></div></c:when><c:otherwise><div class="table-responsive"><table><thead><tr><th>Producto</th><th class="numeric">Precio</th><th class="numeric">Cantidad</th><th>Acciones</th></tr></thead><tbody><c:forEach var="lc" items="${compra.lineaCompras}" varStatus="status"><tr><td><c:out value="${lc.producto.nombre}"/></td><td class="numeric">S/ ${lc.precioUnitario}</td><td class="numeric">${lc.cantidad}</td><td class="actions-cell"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/SvCompra?accion=actualizar&amp;idLineaCompra=${status.index}">Editar</a><form action="${pageContext.request.contextPath}/SvCompra?accion=eliminar" method="post" data-confirm="¿Quitar este producto de la compra?"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="idLineaCompra" value="${status.index}"><button class="btn btn-danger btn-sm" type="submit">Quitar</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<div class="ledger-total"><span>Total</span><strong>S/ ${totalCompra}</strong></div><div class="form-actions"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/">Volver</a><form action="${pageContext.request.contextPath}/SvCompra?accion=guardar" method="post"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><button class="btn btn-primary" type="submit" ${empty compra.lineaCompras ? 'disabled' : ''}><i class="fas fa-check"></i> Guardar compra</button></form></div>
</section></div>
<%@include file="components/footer.jsp"%>
