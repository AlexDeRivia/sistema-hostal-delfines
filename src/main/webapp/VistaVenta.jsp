<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@include file="components/auth.jsp"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@include file="components/head.jsp"%>
<%@include file="components/sidebar.jsp"%>
<%@include file="components/navBar.jsp"%>
<header class="page-header"><div><span class="page-kicker">Comercial · Punto de venta</span><h1>Ventas</h1><p>Prepara la venta y revisa el importe antes de registrarla.</p></div><div class="page-actions"><span class="page-meta">Turno <strong><c:out value="${rventa.turno}"/></strong> · <c:out value="${rventa.fecha}"/></span></div></header>
<c:if test="${not empty sessionScope.errorVenta}"><div class="notice notice-error" role="alert"><i class="fas fa-exclamation-circle"></i><span><c:out value="${sessionScope.errorVenta}"/></span></div><c:remove var="errorVenta" scope="session"/></c:if>
<c:if test="${not empty param.ok}"><div class="notice notice-success" role="status"><i class="fas fa-check-circle"></i><span>Venta guardada correctamente.</span></div></c:if>
<c:if test="${empty clientes or empty productos}"><div class="notice notice-warning"><i class="fas fa-info-circle"></i><span>Registra un cliente y un producto antes de comenzar.</span></div></c:if>
<div class="ledger-layout">
<section class="ledger-surface"><div class="kicker-line"></div><div class="section-title"><h2>Agregar producto</h2></div><form action="${pageContext.request.contextPath}/SvVenta?accion=agregar" method="post"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
<div class="field"><label for="cliente_name">Cliente</label><select id="cliente_name" name="clientId" required><option value="">Seleccionar cliente</option><c:forEach var="cliente" items="${clientes}"><option value="${cliente.id}"><c:out value="${cliente.nombre}"/> <c:out value="${cliente.apellido}"/></option></c:forEach></select></div>
<div class="field"><label for="producto_name">Producto</label><select id="producto_name" name="productId" required><option value="">Seleccionar producto</option><c:forEach var="producto" items="${productos}"><option value="${producto.id}"><c:out value="${producto.nombre}"/> · Stock ${producto.stock}</option></c:forEach></select></div>
<div class="field"><label for="cantidad">Cantidad</label><input type="number" id="cantidad" name="cantidad" min="1" placeholder="Ejemplo: 2" required></div><div class="form-actions"><button class="btn btn-primary" type="submit"><i class="fas fa-plus"></i> Agregar a la venta</button></div></form></section>
<section class="ledger-surface"><div class="section-title"><h2>Detalle de la venta</h2><small>Revisa antes de guardar</small></div>
<c:choose><c:when test="${empty venta.lineaVentas}"><div class="empty-state"><i class="fas fa-receipt"></i><h3>La venta está vacía</h3><p>Selecciona un cliente, producto y cantidad para comenzar.</p></div></c:when><c:otherwise><div class="table-responsive"><table><thead><tr><th>Producto</th><th class="numeric">Cantidad</th><th class="numeric">Precio</th><th class="numeric">Subtotal</th><th>Acciones</th></tr></thead><tbody><c:forEach var="lv" items="${venta.lineaVentas}" varStatus="status"><tr><td><c:out value="${lv.producto.nombre}"/></td><td class="numeric">${lv.cantidad}</td><td class="numeric">S/ ${lv.precioUnitario}</td><td class="numeric">S/ ${lv.cantidad * lv.precioUnitario}</td><td class="actions-cell"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/SvVenta?accion=actualizar&amp;idLineaVenta=${status.index}">Editar</a><form action="${pageContext.request.contextPath}/SvVenta?accion=eliminar" method="post" data-confirm="¿Quitar este producto de la venta?"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="idLineaVenta" value="${status.index}"><button class="btn btn-danger btn-sm" type="submit">Quitar</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<div class="ledger-total"><span>Total</span><strong>S/ ${totalVenta}</strong></div><div class="form-actions"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/">Volver</a><form action="${pageContext.request.contextPath}/SvVenta?accion=guardar" method="post"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><button class="btn btn-primary" type="submit" ${empty venta.lineaVentas ? 'disabled' : ''}><i class="fas fa-check"></i> Guardar venta</button></form></div>
</section></div>
<%@include file="components/footer.jsp"%>
